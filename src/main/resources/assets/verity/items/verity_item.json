          "firstperson_lefthand"
        ],
        "model": {
          "type": "minecraft:special",
          "base": "verity:item/verity_item",
          "model": {
            "type": "verity:verity",
            "first_person": true
          }
        }
      }
    ],
    "fallback": {
      "type": "minecraft:special",
      "base": "verity:item/verity_item",
      "model": {
        "type": "verity:verity"
      }
    }
  }
}
